  * floor below the 4096-frame production ring (4096 / 64 frames = 64). */
 static uint32_t g_tp_engine_ring_msgs = 32;
 
+/* Persistent gate control plane (DS4_TP_PERSIST_GATE=1).  One resident
+ * kernel on its own non-blocking stream eats commands off a mapped
+ * host-written ring; the service thread polls mapped u64 flags instead of
+ * HIP events.  Layout in rocm/ds4_rocm_tp.cuh. */
+static unsigned char *g_tp_persist_ctrl_host; /* pinned, mapped */
+static unsigned char *g_tp_persist_ctrl_dev;
+static hipStream_t g_tp_persist_stream;
+static int g_tp_persist_active;
+static pthread_mutex_t g_tp_persist_pub_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* DS4_TP_GATE_STATS=1: per-gate GPU-timeline cost, stamp-released ->
+ * RX-copy-done, identical in meaning on both paths (legacy: elapsed time
+ * between the tx_ready and rx_consumed events; persistent: wall_clock64
+ * stamps the resident kernel writes next to the two flags).  Summarized
+ * once at shutdown; only the service thread touches the accumulators. */
+static int g_tp_gate_stats;
+static double g_tp_gate_stats_clock_khz;
+static uint64_t g_tp_gate_stats_n;
+static double g_tp_gate_stats_sum_us;
+static double g_tp_gate_stats_max_us;
+static uint64_t g_tp_gate_stats_hist[6]; /* <50 <100 <200 <500 <1000 >= */
+
+/* DS4_TP_GATE_TRACE=<path>: per-gate CSV written at shutdown.  GPU
+ * wall_clock64 stamps (persistent path only: tx released, RX warp started
+ * spinning, peer stamp first seen, RX copy done) plus the two host clocks
+ * the service thread takes around the NHI submit.  Joining both ranks'
+ * files on seq splits the arrival window into one-way latency and rank
+ * skew: rank0 waits L+s, rank1 waits L-s (scripts/tp_gate_trace.py). */
+typedef struct {
+    uint64_t seq;
+    uint32_t layer, gate;
+    uint64_t ts_tx, ts_rxq, ts_seen, ts_rx;
+    uint64_t h_detect_ns, h_submit_ns;
+    double ev_us; /* legacy rows: hipEventElapsedTime(tx_ready, rx_consumed) */
+} ds4_rocm_tp_trace_row;
+enum { DS4_ROCM_TP_TRACE_MAX = 262144 };
+static ds4_rocm_tp_trace_row *g_tp_gate_trace;
+static uint32_t g_tp_gate_trace_n;
+static const char *g_tp_gate_trace_path;
+
+static uint64_t ds4_rocm_tp_host_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static void ds4_rocm_tp_trace_add(const ds4_rocm_tp_request *req) {
+    if (!g_tp_gate_trace || g_tp_gate_trace_n >= DS4_ROCM_TP_TRACE_MAX)
+        return;
+    ds4_rocm_tp_trace_row *row = &g_tp_gate_trace[g_tp_gate_trace_n++];
+    memset(row, 0, sizeof(*row));
+    row->seq = req->seq;
+    row->layer = req->layer;
+    row->gate = req->gate;
+    row->h_detect_ns = req->h_detect_ns;
+    row->h_submit_ns = req->h_submit_ns;
+    if (req->persist && g_tp_persist_ctrl_host) {
+        const uint64_t slot = req->seq % DS4_ROCM_TP_PERSIST_CAP;
+        const unsigned char *c = g_tp_persist_ctrl_host;
+#define DS4_TP_TRACE_LOAD(off) \
+        __atomic_load_n((const uint64_t *)(const void *)((c) + (off)) + slot, \
+                        __ATOMIC_ACQUIRE)
+        row->ts_tx = DS4_TP_TRACE_LOAD(DS4_ROCM_TP_PERSIST_OFF_TS_TX);
+        row->ts_rxq = DS4_TP_TRACE_LOAD(DS4_ROCM_TP_PERSIST_OFF_TS_RXQ);
+        row->ts_seen = DS4_TP_TRACE_LOAD(DS4_ROCM_TP_PERSIST_OFF_TS_SEEN);
+        row->ts_rx = DS4_TP_TRACE_LOAD(DS4_ROCM_TP_PERSIST_OFF_TS_RX);
+#undef DS4_TP_TRACE_LOAD
+    } else {
+        float ms = 0.0f;
+        if (hipEventElapsedTime(&ms, req->tx_ready, req->rx_consumed) ==
+            hipSuccess)
+            row->ev_us = (double)ms * 1000.0;
+    }
+}
+
+static void ds4_rocm_tp_gate_stats_add(double us) {
+    g_tp_gate_stats_n++;
+    g_tp_gate_stats_sum_us += us;
+    if (us > g_tp_gate_stats_max_us) g_tp_gate_stats_max_us = us;
+    const int b = us < 50.0 ? 0 : us < 100.0 ? 1 : us < 200.0 ? 2 :
+                  us < 500.0 ? 3 : us < 1000.0 ? 4 : 5;
+    g_tp_gate_stats_hist[b]++;
+}
+
+/* ---- Resident-kernel launch / pause / resume -------------------------
+ *
+ * CLR's hipDeviceSynchronize, hipFree and hipHostFree wait for every
+ * stream on the device; the resident gate kernel never finishes on its
+ * own, so those calls would deadlock while it is up (observed: worker
+ * wedged in ds4_session_gpu_warmup -> ds4_gpu_end_commands ->
+ * hipDeviceSynchronize; the loopback runtime probe shows the same for
+ * hipFree/hipHostFree).  The guarded wrappers below (routed from every
+ * alias in ds4_rocm.h) pause the kernel: set the shutdown word, let the
+ * dispatcher drain (all published commands complete, consumed == publish)
+ * and exit, make the real call, then relaunch; the kernel resumes
+ * dispatch from the ring's consumed word.  Cost is one kernel exit +
+ * launch per device-wide call (~tens of us), flag off they are the plain
+ * runtime calls. */
+static uint32_t g_tp_persist_rank;
+static pthread_mutex_t g_tp_persist_pause_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static uint32_t *ds4_rocm_tp_persist_shutdown_word(void) {
+    return (uint32_t *)(void *)(g_tp_persist_ctrl_host +
+                                DS4_ROCM_TP_PERSIST_OFF_SHUTDOWN);
+}
+
+static int ds4_rocm_tp_persist_launch(void) {
+    hipLaunchKernelGGL(dsv4_tp_persistent_gate_kernel, dim3(1),
+                       dim3(DS4_ROCM_TP_PERSIST_THREADS), 0,
+                       g_tp_persist_stream, g_tp_persist_ctrl_dev,
+                       g_tp_persist_rank, g_tp_engine_max_spins,
+                       g_tp_engine_state_dev);
+    return hipGetLastError() == hipSuccess;
+}
+
+#undef hipDeviceSynchronize
+#undef hipFree
+#undef hipHostFree
+#undef hipFreeHost
+
+/* Caller holds g_tp_persist_pause_lock and has checked g_tp_persist_active. */
+static void ds4_rocm_tp_persist_pause_locked(void) {
+    __atomic_store_n(ds4_rocm_tp_persist_shutdown_word(), 1u, __ATOMIC_RELEASE);
+    (void)hipStreamSynchronize(g_tp_persist_stream);
+    __atomic_store_n(ds4_rocm_tp_persist_shutdown_word(), 0u, __ATOMIC_RELEASE);
+}
+
+static void ds4_rocm_tp_persist_resume_locked(void) {
+    if (ds4_rocm_tp_persist_launch()) return;
+    fprintf(stderr, DS4_GPU_LOG_PREFIX
+            "persistent TP gate kernel relaunch failed; latching TP failure\n");
+    if (g_tp_engine_state_host) {
+        uint32_t expected = 0;
+        (void)__atomic_compare_exchange_n(g_tp_engine_state_host, &expected,
+                                          1u, 0, __ATOMIC_ACQ_REL,
+                                          __ATOMIC_ACQUIRE);
+    }
+}
+
+hipError_t ds4_rocm_guarded_device_synchronize(void) {
+    if (!g_tp_persist_active) return hipDeviceSynchronize();
+    pthread_mutex_lock(&g_tp_persist_pause_lock);
+    if (!g_tp_persist_active || !g_tp_persist_ctrl_host) {
+        pthread_mutex_unlock(&g_tp_persist_pause_lock);
+        return hipDeviceSynchronize();
+    }
+    ds4_rocm_tp_persist_pause_locked();
+    const hipError_t err = hipDeviceSynchronize();
+    ds4_rocm_tp_persist_resume_locked();
+    pthread_mutex_unlock(&g_tp_persist_pause_lock);
+    return err;
+}
+
+hipError_t ds4_rocm_guarded_free(void *ptr) {
+    if (!g_tp_persist_active) return hipFree(ptr);
+    pthread_mutex_lock(&g_tp_persist_pause_lock);
+    if (!g_tp_persist_active || !g_tp_persist_ctrl_host) {
+        pthread_mutex_unlock(&g_tp_persist_pause_lock);
+        return hipFree(ptr);
+    }
+    ds4_rocm_tp_persist_pause_locked();
+    const hipError_t err = hipFree(ptr);
+    ds4_rocm_tp_persist_resume_locked();
+    pthread_mutex_unlock(&g_tp_persist_pause_lock);
+    return err;
+}
+
+hipError_t ds4_rocm_guarded_host_free(void *ptr) {
+    if (!g_tp_persist_active) return hipHostFree(ptr);
+    pthread_mutex_lock(&g_tp_persist_pause_lock);
+    if (!g_tp_persist_active || !g_tp_persist_ctrl_host) {
+        pthread_mutex_unlock(&g_tp_persist_pause_lock);
+        return hipHostFree(ptr);
+    }
+    ds4_rocm_tp_persist_pause_locked();
+    const hipError_t err = hipHostFree(ptr);
+    ds4_rocm_tp_persist_resume_locked();
+    pthread_mutex_unlock(&g_tp_persist_pause_lock);
+    return err;
+}
+
+#define hipDeviceSynchronize ds4_rocm_guarded_device_synchronize
+#define hipFree ds4_rocm_guarded_free
+#define hipHostFree ds4_rocm_guarded_host_free
+#define hipFreeHost ds4_rocm_guarded_host_free
+
+static void ds4_rocm_tp_gate_stats_report(void) {
+    if (!g_tp_gate_stats) return;
+    const double n = g_tp_gate_stats_n ? (double)g_tp_gate_stats_n : 1.0;
+    fprintf(stderr, DS4_GPU_LOG_PREFIX
+            "TP gate stats (%s): gates=%llu mean=%.1fus max=%.1fus "
+            "hist[<50,<100,<200,<500,<1000,>=1000us]="
+            "%llu,%llu,%llu,%llu,%llu,%llu  (~%.2f ms/token at 86 gates)\n",
+            g_tp_persist_active ? "persistent" : "legacy",
+            (unsigned long long)g_tp_gate_stats_n,
+            g_tp_gate_stats_sum_us / n, g_tp_gate_stats_max_us,
+            (unsigned long long)g_tp_gate_stats_hist[0],
+            (unsigned long long)g_tp_gate_stats_hist[1],
+            (unsigned long long)g_tp_gate_stats_hist[2],
+            (unsigned long long)g_tp_gate_stats_hist[3],
+            (unsigned long long)g_tp_gate_stats_hist[4],
+            (unsigned long long)g_tp_gate_stats_hist[5],
+            g_tp_gate_stats_sum_us / n * 86.0 / 1000.0);
+}
+
+/* Write the per-gate trace CSV and a compact summary (persistent path:
+ * arrival = tx released -> peer stamp seen, copy = seen -> rx_done;
+ * both paths: submit = host detect -> NHI submit returned). */
+static void ds4_rocm_tp_gate_trace_report(void) {
+    if (!g_tp_gate_trace) return;
+    const double khz = g_tp_gate_stats_clock_khz > 0.0 ?
+        g_tp_gate_stats_clock_khz : 100000.0;
+    FILE *f = g_tp_gate_trace_path ? fopen(g_tp_gate_trace_path, "w") : NULL;
+    if (f) {
+        fprintf(f, "seq,layer,gate,ts_tx,ts_rxq,ts_seen,ts_rx,"
+                   "h_detect_ns,h_submit_ns,ev_us\n");
+    }
+    double sum_arrive = 0, sum_copy = 0, sum_submit = 0, sum_spin = 0;
+    uint64_t n_gpu = 0, n_host = 0;
+    for (uint32_t i = 0; i < g_tp_gate_trace_n; i++) {
+        const ds4_rocm_tp_trace_row *r = &g_tp_gate_trace[i];
+        if (f) {
+            fprintf(f, "%llu,%u,%u,%llu,%llu,%llu,%llu,%llu,%llu,%.1f\n",
+                    (unsigned long long)r->seq, r->layer, r->gate,
+                    (unsigned long long)r->ts_tx,
+                    (unsigned long long)r->ts_rxq,
+                    (unsigned long long)r->ts_seen,
+                    (unsigned long long)r->ts_rx,
+                    (unsigned long long)r->h_detect_ns,
+                    (unsigned long long)r->h_submit_ns, r->ev_us);
+        }
+        if (r->ts_tx && r->ts_seen && r->ts_rx && r->ts_rxq &&
+            r->ts_tx != ~0ull && r->ts_seen != ~0ull &&
+            r->ts_rx != ~0ull && r->ts_rxq != ~0ull &&
+            r->ts_seen >= r->ts_tx && r->ts_rx >= r->ts_seen) {
+            sum_arrive += (double)(r->ts_seen - r->ts_tx) * 1000.0 / khz;
+            sum_copy += (double)(r->ts_rx - r->ts_seen) * 1000.0 / khz;
+            /* RX warp spin start relative to our TX release (negative =
+             * the RX command was already waiting when we released). */
+            sum_spin += ((double)r->ts_rxq - (double)r->ts_tx) * 1000.0 / khz;
+            n_gpu++;
+        }
+        if (r->h_submit_ns >= r->h_detect_ns && r->h_detect_ns) {
+            sum_submit += (double)(r->h_submit_ns - r->h_detect_ns) / 1000.0;
+            n_host++;
+        }
+    }
+    if (f) fclose(f);
+    fprintf(stderr, DS4_GPU_LOG_PREFIX
+            "TP gate trace: rows=%u%s%s",
+            g_tp_gate_trace_n,
+            g_tp_gate_trace_path ? " -> " : "",
+            g_tp_gate_trace_path ? g_tp_gate_trace_path : "");
+    if (n_host)
+        fprintf(stderr, "  submit(host detect->ioctl done) mean=%.1fus",
+                sum_submit / (double)n_host);
+    if (n_gpu)
+        fprintf(stderr, "  arrival(tx released->peer stamp seen) mean=%.1fus"
+                "  copy(seen->rx_done) mean=%.1fus"
+                "  rx spin start rel. tx release mean=%.1fus",
+                sum_arrive / (double)n_gpu, sum_copy / (double)n_gpu,
+                sum_spin / (double)n_gpu);
+    fprintf(stderr, "\n");
+    free(g_tp_gate_trace);
+    g_tp_gate_trace = NULL;
+    g_tp_gate_trace_n = 0;
+}
+
+static int ds4_rocm_tp_persist_wanted(void) {
+    const char *v = getenv("DS4_TP_PERSIST_GATE");
+    return v && strcmp(v, "1") == 0;
+}
+
+static void ds4_rocm_tp_poll_spin(int *tick) {
+    if ((++(*tick) & 0x3ff) == 0) {
+#if defined(__linux__)
+        sched_yield();
+#endif
+    }
+}
+
+/* Poll a mapped per-seq flag until it carries `seq` (returns 1), or the
+ * engine state word latches (returns 0; the latch, not this poll, is what
+ * aborts the corresponding GPU spin, mirroring the event-sync path). */
+static int ds4_rocm_tp_wait_flag(const uint64_t *flags, uint64_t seq) {
+    int tick = 0;
