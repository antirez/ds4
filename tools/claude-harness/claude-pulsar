#!/bin/bash
# claude-pulsar — launch Claude Code against the local pulsar stack.
#
# Main model      : pulsar-server (Anthropic /v1/messages, 1M ctx) via the
#                   model router, which sends haiku-class background traffic
#                   to the small/fast box instead.
# Context window  : Claude Code sizes the window from the requested model
#                   name's [1m] suffix — verified (header dump, 2026-08-01)
#                   to work on CUSTOM names too: "deepseek-v4-flash[1m]"
#                   sends model=deepseek-v4-flash WITH the context-1m beta,
#                   i.e. 1M-token accounting and a late auto-compact trigger.
#                   Without the suffix Claude Code assumes a small window —
#                   keep [1m] on any model name you substitute.
#
# Usage: claude-pulsar [claude args...]
#
# Env overrides:
#   CLAUDE_PULSAR_URL    router (or pulsar) base URL   [default http://sparky:8100]
#   CLAUDE_PULSAR_MODEL  model alias to request        [default deepseek-v4-flash[1m]]

set -u

BASE_URL="${CLAUDE_PULSAR_URL:-http://sparky:8100}"
MODEL="${CLAUDE_PULSAR_MODEL:-deepseek-v4-flash[1m]}"

if ! curl -sf --max-time 5 "${BASE_URL}/v1/models" >/dev/null 2>&1; then
    echo "claude-pulsar: warning: ${BASE_URL}/v1/models not answering" >&2
    echo "  (is pulsar-model-router / pulsar-server up?)" >&2
fi

unset ANTHROPIC_API_KEY
export ANTHROPIC_BASE_URL="$BASE_URL"
export ANTHROPIC_AUTH_TOKEN="local"
export ANTHROPIC_MODEL="$MODEL"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

exec claude "$@"
