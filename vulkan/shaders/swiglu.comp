#version 460 core
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer GateBuf { float gate_val[]; };
layout(set = 0, binding = 1) buffer UpBuf   { float up_val[];   };
layout(set = 0, binding = 2) buffer OutBuf  { float out_val[];  };

layout(push_constant) uniform PC {
    uint n;
    float clamp;
    float weight;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.n) return;
    float g = gate_val[gid];
    float u = up_val[gid] * pc.weight;
    float silu = g * (1.0 / (1.0 + exp(-g)));
    if (pc.clamp > 0.0 && silu > pc.clamp) silu = pc.clamp;
    if (pc.clamp > 0.0 && silu < -pc.clamp) silu = -pc.clamp;
    out_val[gid] = silu * u;
}
