#version 460 core
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer OutBuf { float data[]; };

layout(push_constant) uniform PushConstants {
    uint count;
    float value;
} pc;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.count) return;
    data[gid] = pc.value;
}
