+/* Each SIMD group computes 64 output channels by 32 tokens, reusing packed
+ * operands across 32 FP32 matrix accumulators. Packing retains the generic
+ * kernel's half rounding and its exact ascending K8 accumulation order.
+ * Host selection requires K%32,N%64,T%32==0; whole SIMD tiles cover the
+ * smaller 128x64 boundary without partial matrix stores. */
+kernel void kernel_qwen4_prefill_packed_mm(
+        constant ds4_metal_args_mul_mm &a,
+        device const half *wp,
+        device const half *xp,
+        device float *out,
+        uint3 group [[threadgroup_position_in_grid]],
+        ushort sg [[simdgroup_index_in_threadgroup]]) {
+    constexpr uint NR=64u, NSG=2u, NW=8u;
+    const uint row=group.y*128u+(sg%NSG)*NR;
+    const uint tok=group.x*64u+(sg/NSG)*32u;
+    if (row >= (uint)a.ne0 || tok >= (uint)a.ne1) return;
+    simdgroup_float8x8 acc[4u*NW];
+    FOR_UNROLL (uint j=0;j<4u*NW;j++) acc[j]=make_filled_simdgroup_matrix<float,8>(0.0f);
+    for (uint kb=0;kb<(uint)a.ne00/32u;kb++) {
+        device const half *xb=xp+((uint64_t)(tok/32u)*(a.ne00/32u)+kb)*1024u;
+        FOR_UNROLL (uint sub=0;sub<4u;sub++) {
+            simdgroup_half8x8 wm[NW],xm[4];
+            FOR_UNROLL (uint j=0;j<NW;j++) {
+                const uint r=row+8u*j;
+                device const half *wa=wp+((uint64_t)(r/64u)*(a.ne00/32u)+kb)*2048u;
+                simdgroup_load(wm[j],wa+sub*512u+((r%64u)/8u)*64u,8,0,false);
+            }
+            FOR_UNROLL (uint j=0;j<4u;j++) simdgroup_load(xm[j],xb+sub*256u+j*64u,8,0,false);
+            FOR_UNROLL (uint j=0;j<4u*NW;j++) simdgroup_multiply_accumulate(acc[j],xm[j/NW],wm[j%NW],acc[j]);
+        }
+    }
+    FOR_UNROLL (uint j=0;j<4u*NW;j++)
+        simdgroup_store(acc[j],out+(uint64_t)(tok+8u*(j/NW))*a.ne0+row+8u*(j%NW),a.ne0,0,false);
+}
