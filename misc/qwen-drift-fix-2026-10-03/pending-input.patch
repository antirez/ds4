+/* Global fragment packing: within each (N64,K32) block, store the same
+ * contiguous 8x8 matrices used by the production threadgroup swizzle.
+ * Thus device matrix loads have stride 8 and touch one contiguous matrix. */
+template <bool Q8>
+kernel void kernel_qwen4_prefill_pack_weights(
+        constant ds4_metal_args_mul_mm &a,
+        device const char *weights,
+        device half *packed,
+        uint3 group [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]]) {
+    threadgroup half tile[2048];
+    const uint r=group.y*64u+tid/2u, k=group.x*32u+(tid&1u)*16u;
+    half4x4 v;
+    if constexpr (Q8) {
+        device const block_q8_0 *w=(device const block_q8_0 *)weights+(uint64_t)r*(a.ne00/32u)+group.x;
+        const float d=(float)w->d;
+        FOR_UNROLL (uint j=0;j<16u;j++) v[j/4u][j%4u]=(half)((float)w->qs[(tid&1u)*16u+j]*d);
+    } else {
+        v=*(device const half4x4 *)(weights+((uint64_t)r*a.ne00+k)*sizeof(half));
+    }
+    FOR_UNROLL (uint j=0;j<16u;j++) {
+        const uint ks=(2u*(tid&1u)+j/8u), ns=(tid/2u)/8u;
+        tile[(ks*8u+ns)*64u+(j%8u)*8u+(tid/2u)%8u]=v[j/4u][j%4u];
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    device half4 *dst=(device half4 *)(packed+((uint64_t)group.y*(a.ne00/32u)+group.x)*2048u);
+    FOR_UNROLL (uint j=0;j<4u;j++) dst[tid+128u*j]=((threadgroup half4 *)tile)[tid+128u*j];
+}
