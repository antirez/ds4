+kernel void kernel_qwen4_prefill_pack_weights<true>(constant ds4_metal_args_mul_mm &,device const char *,device half *,uint3,ushort);
+template [[host_name("kernel_qwen4_prefill_pack_f16")]]
+kernel void kernel_qwen4_prefill_pack_weights<false>(constant ds4_metal_args_mul_mm &,device const char *,device half *,uint3,ushort);
+
+kernel void kernel_qwen4_prefill_pack_x(
+        constant ds4_metal_args_mul_mm &a,
+        device const packed_float4 *x,
+        device half *packed,
+        uint3 group [[threadgroup_position_in_grid]],
+        ushort tid [[thread_index_in_threadgroup]]) {
+    threadgroup half tile[1024];
+    const uint tok=group.y*32u+tid/4u, k=group.x*32u+(tid%4u)*8u;
+    device const packed_float4 *src=x+((uint64_t)tok*a.ne00+k)/4u;
+    const half4 x0=half4(float4(src[0])), x1=half4(float4(src[1]));
+    const uint at=((tid%4u)*4u+(tid/4u)/8u)*64u+((tid/4u)%8u)*8u;
+    *(threadgroup half4 *)(tile+at)=x0;
+    *(threadgroup half4 *)(tile+at+4u)=x1;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    device half4 *dst=(device half4 *)(packed+((uint64_t)group.y*(a.ne00/32u)+group.x)*1024u);
+    dst[tid]=((threadgroup half4 *)tile)[tid];
+    dst[tid+128u]=((threadgroup half4 *)tile)[tid+128u];
+}
