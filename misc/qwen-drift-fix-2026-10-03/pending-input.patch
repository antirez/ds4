+        const ds4_gpu_tensor *x, const ds4_gpu_tensor *lists, const ds4_gpu_tensor *counts) {
+    if (!hp || !qwen4_gain5_prefill_enabled(args.n_tokens) || g_batch_encoder_concurrent ||
+        args.n_tokens != 8192u || args.weight_type != 12u || args.in_dim != 2560u ||
+        args.out_rows != 640u || args.n_slots != 10u || args.n_out < args.n_slots ||
+        args.n_out > 11u || args.tail_base ||
