+/* Diagnostic hot-expert packing. A plan owns whole expert lists from exactly
+ * this resident/missing pass. Empty active lists are never dispatched. */
+typedef struct {
+    qwen4_moe_mm_args hot, cold;
+    uint32_t hot_count, cold_count, rows;
+    uint32_t offsets[513];
+} qwen4_gain5_hot_plan;
+
+static bool qwen4_gain5_plan(qwen4_moe_mm_args args, qwen4_gain5_hot_plan *p) {
+    const qwen4_stream_weights *s = g_qwen4_stream_weights;
+    if (!p || !s || !s->frequency || s->table->n_total_expert != args.n_expert ||
+        args.n_expert > 512u || args.n_active_expert > args.n_expert) return false;
+    *p = (qwen4_gain5_hot_plan){.hot=args, .cold=args};
+    p->hot.n_active_expert = p->cold.n_active_expert = 0;
+    p->hot.tail_base = p->cold.tail_base = 0;
+    const uint32_t active = args.n_active_expert ? args.n_active_expert : args.n_expert;
+    bool selected[512] = {0};
+    for (uint32_t i = 0; i < active; i++) {
+        const uint32_t e = args.n_active_expert ? args.active_expert[i] : i;
+        if (e >= args.n_expert || selected[e]) return false;
+        selected[e] = true;
+        const uint32_t full = s->frequency[e];
+        const int32_t pass = s->mm_pass_counts ? s->mm_pass_counts[e] : (int32_t)full;
+        if (pass < 0 || (pass && (uint32_t)pass != full) || full > args.list_cap) return false;
+        if (!pass) continue;
+        if (full >= 256u) p->hot.active_expert[p->hot_count++] = e;
+        else p->cold.active_expert[p->cold_count++] = e;
+    }
+    p->hot.n_active_expert = p->hot_count;
+    p->cold.n_active_expert = p->cold_count;
+    uint64_t rows = 0;
+    for (uint32_t e = 0; e < args.n_expert; e++) {
+        const uint32_t count = s->frequency[e];
+        const int32_t pass = s->mm_pass_counts ? s->mm_pass_counts[e] : (int32_t)count;
+        if (pass < 0 || (pass && (uint32_t)pass != count)) return false;
+        if (selected[e] && pass && count >= 256u) rows += ((uint64_t)count + 63u) / 64u * 64u;
+        if (rows > UINT32_MAX) return false;
+        p->offsets[e + 1u] = (uint32_t)rows;
+    }
+    p->rows = (uint32_t)rows;
+    return true;
+}
+
+static NSArray<id<MTLBuffer>> *qwen4_gain5_ranges(uint32_t experts) {
+    NSMutableArray<id<MTLBuffer>> *ranges = [NSMutableArray array];
+    for (uint32_t first = 0; first < experts; first += 32u) {
+        const uint32_t range[] = {first, MIN(32u, experts - first)};
+        id<MTLBuffer> b = [g_device newBufferWithBytes:range length:sizeof(range)
+                                               options:MTLResourceStorageModeShared];
+        if (!b) return nil;
+        [ranges addObject:b];
+    }
+    return ranges;
+}
