+    const qwen4_bind gather_b[] = {map,b[4],px};
+    const struct { uint32_t rows, dim; } gather = {p.rows,args.in_dim};
+    if (!qwen4_dispatch(QWEN4_K_MOE_PACKED_MAP, &p.hot, sizeof(p.hot), map_b, 4,
