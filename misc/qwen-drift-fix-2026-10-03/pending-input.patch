+/* One diagnostic control permits a same-binary comparison of the prefill
+ * bundle. The unset/default path stays on the established kernels. */
+static bool ds4_gpu_qwen4_prefill_bundle_enabled(void) {
+    return g_ssd_streaming_mode &&
+        ds4_gpu_env_bool("DS4_DIAG_QWEN4_PREFILL_BUNDLE") == 1 &&
+        ds4_gpu_device_name_contains("M1 Max");
+}
+
+/* Measured prefill kernels use the original arithmetic without global packing.
+ * Enable explicitly for comparison with the established kernels. */
+static bool ds4_gpu_qwen4_prefill_opt_enabled(void) {
+    return g_ssd_streaming_mode &&
+        ds4_gpu_env_bool("DS4_DIAG_QWEN4_PREFILL_OPT") == 1 &&
+        ds4_gpu_device_name_contains("M1 Max");
+}
+
+static bool ds4_gpu_qwen4_packed_dense_shape(
+        uint64_t in_dim, uint64_t out_dim, uint64_t n_tok, bool q8) {
+    if (n_tok < 8192u || (n_tok % 32u) != 0u) return false;
+    if (!q8) return in_dim == 10240u && out_dim == 320u;
+    return (in_dim == 2560u &&
+            (out_dim == 6144u || out_dim == 10240u || out_dim == 12288u)) ||
+           (in_dim == 6144u && out_dim == 2560u);
+}
+
+/* Return false before encoding any work when optional preparation fails.
+ * W reuses the existing Q8 half scratch; X is packed once per projection.
+ * All consumers use the ordered encoder and tracked resources. Retaining
+ * each allocation also covers growth inside unretained command buffers. */
+static bool ds4_gpu_qwen4_try_packed_dense(
+        id<MTLCommandBuffer> cb, id<MTLBuffer> weights, NSUInteger weight_offset,
+        id<MTLBuffer> input, NSUInteger input_offset,
+        id<MTLBuffer> output, NSUInteger output_offset,
+        uint64_t in_dim, uint64_t out_dim, uint64_t n_tok, bool q8) {
+    if (!ds4_gpu_qwen4_packed_dense_shape(in_dim, out_dim, n_tok, q8) ||
+        !ds4_gpu_qwen4_prefill_bundle_enabled() ||
+        n_tok > NSUIntegerMax / in_dim / sizeof(uint16_t)) return false;
+    const NSUInteger weight_bytes = (NSUInteger)(in_dim * out_dim * sizeof(uint16_t));
+    const NSUInteger input_bytes = (NSUInteger)(in_dim * n_tok * sizeof(uint16_t));
+    id<MTLComputePipelineState> pack_weights = ds4_gpu_get_pipeline(q8
+        ? "kernel_qwen4_prefill_pack_q8" : "kernel_qwen4_prefill_pack_f16");
+    id<MTLComputePipelineState> pack_input =
+        ds4_gpu_get_pipeline("kernel_qwen4_prefill_pack_x");
+    id<MTLComputePipelineState> product =
+        ds4_gpu_get_pipeline("kernel_qwen4_prefill_packed_mm");
+    if (!pack_weights || !pack_input || !product ||
+        !ds4_gpu_ensure_scratch_buffer(&g_qwen4_packed_x_buffer,
+            &g_qwen4_packed_x_bytes, input_bytes, "qwen prefill packed input") ||
+        !ds4_gpu_ensure_scratch_buffer(&g_q8_prefill_scratch_buffer,
+            &g_q8_prefill_scratch_bytes, weight_bytes, "q8 prefill weights")) return false;
+    [g_transient_buffers addObject:g_qwen4_packed_x_buffer];
+    [g_transient_buffers addObject:g_q8_prefill_scratch_buffer];
+    ds4_gpu_mul_mm_args args = ds4_gpu_make_mm_args(
+        in_dim, out_dim, n_tok, in_dim * sizeof(uint16_t));
+#ifdef DS4_TEST_QWEN4_PACKED_DENSE
+    DS4_TEST_QWEN4_PACKED_DENSE(in_dim, out_dim, n_tok, q8);
+#endif
+    id<MTLComputeCommandEncoder> enc = ds4_gpu_compute_encoder(cb);
+    [enc setComputePipelineState:pack_weights];
+    [enc setBytes:&args length:sizeof(args) atIndex:0];
+    [enc setBuffer:weights offset:weight_offset atIndex:1];
+    [enc setBuffer:g_q8_prefill_scratch_buffer offset:0 atIndex:2];
+    [enc dispatchThreadgroups:MTLSizeMake((NSUInteger)(in_dim / 32u),
+                                          (NSUInteger)(out_dim / 64u), 1)
+         threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+    [enc setComputePipelineState:pack_input];
+    [enc setBuffer:input offset:input_offset atIndex:1];
+    [enc setBuffer:g_qwen4_packed_x_buffer offset:0 atIndex:2];
+    [enc dispatchThreadgroups:MTLSizeMake((NSUInteger)(in_dim / 32u),
+                                          (NSUInteger)(n_tok / 32u), 1)
+         threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+    [enc setComputePipelineState:product];
+    [enc setBuffer:g_q8_prefill_scratch_buffer offset:0 atIndex:1];
+    [enc setBuffer:g_qwen4_packed_x_buffer offset:0 atIndex:2];
+    [enc setBuffer:output offset:output_offset atIndex:3];
+    [enc dispatchThreadgroups:MTLSizeMake((NSUInteger)((n_tok + 63u) / 64u),
+                                          (NSUInteger)((out_dim + 127u) / 128u), 1)
+         threadsPerThreadgroup:MTLSizeMake(128, 1, 1)];
+    ds4_gpu_end_compute_encoder(cb, enc);
+    return true;
+}
