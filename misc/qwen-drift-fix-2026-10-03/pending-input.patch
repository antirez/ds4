+    const uint64_t half_x_bytes = (uint64_t)args.n_tokens * args.in_dim * 2u;
+    const uint64_t half_mid_bytes = (uint64_t)args.n_tokens * args.n_out * args.out_rows * 2u;
+    /* Capacity uses the complete validated routing only for sizing. This
