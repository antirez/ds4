+        !qwen4_nax_scratch(&g_qwen4_gain5_hot_a, &g_qwen4_gain5_hot_a_bytes, a_bytes) ||
+        !qwen4_nax_scratch(&g_qwen4_gain5_hot_b, &g_qwen4_gain5_hot_b_bytes, a_bytes) ||
