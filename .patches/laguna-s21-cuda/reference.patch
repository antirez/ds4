+        const int32_t expert_i = selected[pair];
+        if (expert_i < 0 || (uint32_t)expert_i >= n_total_expert) continue;
+        const char *row_ptr =
+            down_base + (uint64_t)(uint32_t)expert_i * down_expert_bytes +
