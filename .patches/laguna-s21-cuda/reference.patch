+        if (Q6_DOWN) {
+            for (uint32_t b = lane; b < midq_blocks; b += 8u) {
+                part += dev_dot_q6_K_q8_K_block(
+                        (const cuda_block_q6_K *)row_ptr + b,
+                        mid_row + b);
