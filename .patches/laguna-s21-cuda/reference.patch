+    const uint64_t flat = blockIdx.x;
+    const uint32_t token = (uint32_t)(flat / row_tiles);
+    const uint32_t row_tile =
+        (uint32_t)(flat - (uint64_t)token * row_tiles);
+    if (token >= n_tokens) return;
