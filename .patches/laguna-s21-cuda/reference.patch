+                s2 += yl[l + 1] * (float)(qs & low_masks[il / 2][1]);
+                s3 += ((h[l / 2] & hm[0]) ? 0.0f : yl[l + 0]) +
+                      ((h[l / 2] & hm[1]) ? 0.0f : yl[l + 1]);
+                s4 += yl[l + 16] * (float)(qs & low_masks[il / 2][2]);
+                s5 += yl[l + 17] * (float)(qs & low_masks[il / 2][3]);
+                s6 += ((h[l / 2] & hm[2]) ? 0.0f : yl[l + 16]) +
