+    const uint32_t byte_off = (group >> 1u) * 32u + lane;
+    const uint32_t shift = (group & 1u) * 4u;
+    const uint32_t q = (block->qs[byte_off] >> shift) & 0x0fu;
+    return dev_f16_to_f32(block->d) * (float)scale * (float)q -
