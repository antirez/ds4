+    if (row >= out_dim || token0 >= n_tokens) return;
+    const uint64_t row_blocks = in_dim / CUDA_QK_K;
+    const cuda_block_q4_K *wr = weight + row * row_blocks;
+    float sums[TOKEN_TILE] = {0.0f};
