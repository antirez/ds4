+                                     g->norm, n_tokens);
+        }
+        if (ok) {
+            ok = ds4_gpu_laguna_head_rms_norm_rope_tensor(
+                    g->k,
+                    model->map,
+                    model->size,
+                    l->attn_k_norm->abs_offset,
+                    n_tokens,
+                    DS4_DFLASH_N_HEAD_KV,
+                    DS4_DFLASH_HEAD_DIM,
+                    DS4_DFLASH_HEAD_DIM,
+                    pos0,
+                    1048576u,
+                    500000.0f,
+                    1.0f,
+                    0.0f,
+                    1.0f,
+                    0.0f,
+                    0.0f,
+                    DS4_RMS_EPS) != 0;
+        }
+        if (ok && il == 0u) {
+            dflash_debug_tensor_stats("inject layer0 k",
+                                      g->k,
+                                      (uint64_t)n_tokens *
+                                          DS4_DFLASH_N_HEAD_KV *
+                                          DS4_DFLASH_HEAD_DIM);
+            dflash_debug_tensor_stats("inject layer0 v",
+                                      g->v,
+                                      (uint64_t)n_tokens *
+                                          DS4_DFLASH_N_HEAD_KV *
+                                          DS4_DFLASH_HEAD_DIM);
+        }
+        if (ok) {
+            ok = ds4_gpu_dflash_store_kv_tensor(
+                    g->key_cache[il],
+                    g->value_cache[il],
+                    g->k,
+                    g->v,
+                    pos0,
+                    n_tokens,
+                    DS4_DFLASH_SWA,
+                    DS4_DFLASH_N_HEAD_KV * DS4_DFLASH_HEAD_DIM) != 0;
+        }
+    }
+    if (ds4_gpu_commands_active() && ds4_gpu_end_commands() == 0) ok = false;
+    return ok;
+}
