+    DS4_DFLASH_ALLOC(target_tops, block * sizeof(uint32_t));
+#undef DS4_DFLASH_ALLOC
+
+    const uint64_t cache_bytes =
+        (uint64_t)DS4_DFLASH_SWA * kv_dim * sizeof(uint16_t);
+    for (uint32_t il = 0; il < DS4_DFLASH_N_LAYER; il++) {
