+            (((block->qh[qh_base + lane] >> 0u) & 3u) << 4u);
+        scale = block->scales[scale_base + lane / 16u + 0u];
+    } else if (quarter == 1u) {
+        q = (block->ql[ql_base + 32u + lane] & 0x0fu) |
+            (((block->qh[qh_base + lane] >> 2u) & 3u) << 4u);
+        scale = block->scales[scale_base + lane / 16u + 2u];
